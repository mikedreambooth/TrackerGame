{
  "name": "trackergame",
  "private": true,
  "version": "0.1.0",
  "description": "DIY camera-based motion games console for the living room",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "games/*"
  ],
  "scripts": {
    "postinstall": "node scripts/fetch-assets.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:games": "node scripts/build.mjs --games",
    "start": "node server/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
